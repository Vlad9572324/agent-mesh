[Unit]
Description=Agent Mesh HTTPS service
ConditionVirtualization=lxc
ConditionPathExists=/etc/agent-link-lxc-target
Wants=network-online.target postgresql.service
After=network-online.target postgresql.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=agent-link
Group=agent-link
WorkingDirectory=/opt/agent-link/current
ExecStart=/opt/agent-link/current/agent-link serve --database-url-file /etc/agent-link/database-url --listen 0.0.0.0:8766 --tls-cert /etc/agent-link/server.crt --tls-key /etc/agent-link/server.key --web-dir /opt/agent-link/current/web
Restart=always
RestartSec=5s
TimeoutStopSec=15s
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LimitCORE=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agent-link

# Namespace-based sandboxing is intentionally omitted: this unit must work in
# an unprivileged LXC without enabling nesting or relaxing its AppArmor policy.
[Install]
WantedBy=multi-user.target
